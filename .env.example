# Copy to `.env`. Docker Compose loads it automatically from this directory.
#
# Give each checkout of the game its own identity so several versions
# (irefrixs, z00lus, this fork) can coexist on one host. COMPOSE_PROJECT_NAME
# is a built-in Compose variable, so setting it here needs no change to
# docker-compose.yaml -- and it makes the project independent of the folder
# name, which is otherwise what Compose derives it from.
COMPOSE_PROJECT_NAME=marvelchampions
